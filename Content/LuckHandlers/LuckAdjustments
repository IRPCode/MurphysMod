using System;
using MurphysMod.Content.Ambience;
using Terraria;
using Terraria.ModLoader;


namespace MurphysMod.Content.LuckHandlers
{
    public class LuckAdjustments : GlobalNPC
    {
        public override void EditSpawnRate(Player player, ref int spawnRate, ref int maxSpawns)
        {
            double luckVal = player.GetModPlayer<LuckHandler>().luckValue();
            spawnRate *= (int)(1 - (luckVal / 10));
            maxSpawns *= (int)(1 + (luckVal / 10));
        }

    }
}
